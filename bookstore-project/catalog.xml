<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- catalog sits at the very top since it's the container holding every book we have -->
  <xs:element name="catalog">
    <xs:complexType>
      <xs:sequence>

        <!-- unbounded because a bookstore obviously needs more than one book listed -->
        <xs:element name="book" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>

              <!-- title is just plain text, nothing fancy needed here -->
              <xs:element name="title" type="xs:string"/>

              <!-- kept this separate from title so it's easier to read and validate on its own -->
              <xs:element name="publicationYear" type="xs:integer"/>

              <!-- author needs two parts, so it gets its own little structure -->
              <xs:element name="author">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="firstName" type="xs:string"/>
                    <xs:element name="lastName" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

            </xs:sequence>

            <!-- id and available describe the book itself, so they're attributes, not child elements -->
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="available" type="xs:boolean" use="required"/>
          </xs:complexType>
        </xs:element>

      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>